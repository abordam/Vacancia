rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Partidas online: cualquier jugador con sesión anónima puede leer y jugar.
    // Cada escritura debe subir el contador de versión en 1 (evita sobrescrituras viejas).
    match /games/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && code.size() == 5
                    && request.resource.data.host == request.auth.uid
                    && request.resource.data.v == 1;
      allow update: if request.auth != null
                    && request.resource.data.v == resource.data.v + 1;
      allow delete: if false;
    }

    // Estadísticas anónimas de partidas terminadas: solo se pueden crear, nunca leer desde el juego.
    match /stats/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['version','mods','jugadores','bots','cambios','ruta','turnos','minutos','stats','at'])
                    && request.resource.data.jugadores is int && request.resource.data.jugadores <= 5;
      allow read, update, delete: if false;
    }

    // Opiniones de jugadores: solo se pueden crear, con textos cortos.
    match /feedback/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['version','mods','jugadores','diversion','sobra','falta','at'])
                    && request.resource.data.diversion is int
                    && request.resource.data.diversion >= 1 && request.resource.data.diversion <= 5
                    && request.resource.data.sobra.size() <= 500
                    && request.resource.data.falta.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
